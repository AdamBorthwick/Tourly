{
  "manifest_version": 3,
  "name": "Tourly Editor",
  "version": "0.4.9",
  "description": "Build and edit guided video tours for your Webflow pages, then export the embed code.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tourly Editor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/playerjs.min.js", "content/engine.js", "supabase-config.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
