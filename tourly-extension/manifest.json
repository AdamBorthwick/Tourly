{
  "manifest_version": 3,
  "name": "Tourly Editor",
  "version": "0.4.7",
  "description": "Build and edit guided video tours for your Webflow pages, then export the embed code.",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Tourly Editor"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/playerjs.min.js", "content/engine.js", "supabase-config.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
